# Copy to .env and fill in locally. Never commit .env.
# The dataset credentials are distributed privately by the organizers; do not paste them here.

# Named AWS CLI profile that holds the dataset credentials (configured with `aws configure --profile`)
AWS_PROFILE=factored
AWS_REGION=us-east-2
DATASET_BUCKET=

# Language model provider (OpenAI)
OPENAI_API_KEY=
LLM_MODEL=
# Optional: API base URL, per-request timeout and bounded retries (M5)
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
# Total budget for the model calls of one turn, and connecting sentences on/off (M18)
LLM_TURN_DEADLINE_SECONDS=20
LLM_CONNECT_ENABLED=true

# Spend and abuse limits for the public deployment
LLM_MAX_TOKENS_PER_CONVERSATION=
RATE_LIMIT_REQUESTS_PER_MINUTE=

# Policy configuration (defaults to config/policy.yaml)
POLICY_CONFIG_PATH=

# Simulated business date (YYYY-MM-DD) for transaction-age rules; the dataset ends on 2026-06-17.
# Session age always uses real time (dispute policy, "Business date").
BUSINESS_DATE=2026-06-17

# PostgreSQL roles (M1, M9). Three roles; see README.md, "Database roles":
# - admin: the bootstrap superuser of the container (POSTGRES_USER below). Only for
#   administration: scripts/db_roles.py --admin-url and the test databases (TEST_DATABASE_URL).
#   Never used by the application and never modified by the roles script.
# - owner: owns the tables; runs `alembic upgrade head` and scripts/load_core_banking.py.
#   NOSUPERUSER, no CREATEROLE. Created by scripts/db_roles.py.
# - app: the running application; read-only on Core Banking. Created by scripts/db_roles.py.
# The owner and the app must be different from the admin user.
# e.g. postgresql+psycopg://disputes_app:<password>@localhost:5432/disputes
DATABASE_URL=
# e.g. postgresql+psycopg://disputes_owner:<password>@localhost:5432/disputes
MIGRATION_DATABASE_URL=
# Optional instead of --admin-url; the admin password must be written in the URL
# (PGPASSWORD and password files are ignored), e.g. postgresql://disputes:<password>@localhost:5432/postgres
ADMIN_DATABASE_URL=

# Identity service (M2): test OTP and JWT signing key
TEST_OTP=
JWT_SECRET=

# Decision model service (M6): Kev TypeSafe API. Local: http://localhost:8008;
# in docker compose: http://kev:8008. Empty: Kev is not configured (fallback only).
KEV_BASE_URL=
# Per-call timeout (no retries); capped by what is left of the turn deadline
KEV_TIMEOUT_SECONDS=2

# Business day boundary (HH:MM): the business date D covers D at this time up to D+1 at this time.
# as_of = BUSINESS_DATE + 1 day at BUSINESS_DAY_CUTOFF. Dataset timestamps are naive local times.
BUSINESS_DAY_CUTOFF=06:00

# PostgreSQL service in docker-compose.yml: the bootstrap superuser (admin role).
# Set a password before `docker compose up db`.
POSTGRES_USER=disputes
POSTGRES_PASSWORD=
POSTGRES_DB=disputes

# Test database server, as the admin role: a maintenance database on the same server
# (e.g. postgresql+psycopg://disputes:<password>@localhost:5432/postgres).
# Tests create and drop a temporary database disputes_test_<uuid> on each run.
TEST_DATABASE_URL=

# HMAC key for customer document numbers (only the keyed hash is stored)
DOCUMENT_HASH_KEY=

# HMAC key for pseudonymous customer references (LLM context, handoff packets). Separate from
# DOCUMENT_HASH_KEY so each can be rotated on its own. Required: the app does not start without it.
PSEUDONYM_KEY=

# Identity service (M2): OTP challenge lifetime and lockout per document number.
# OTP_MAX_FAILURES failed OTPs within OTP_FAILURE_WINDOW_MIN lock the document until the
# oldest failure leaves the window. Independent of AUTH_MAX_ATTEMPTS in config/policy.yaml.
OTP_TTL_MIN=5
OTP_MAX_FAILURES=3
OTP_FAILURE_WINDOW_MIN=15

# Audit API (M11): bearer token of the agent role (at least 32 characters). Empty: the audit
# API answers 503. Customers' session tokens never give access.
AGENT_API_TOKEN=
# What turn traces keep of the customer's message: masked (default: e-mails and long digit
# runs replaced), full, or omitted.
AUDIT_MESSAGE_MODE=masked
# Token rates (USD per million tokens) for the estimated cost of each turn. Empty: cost unknown.
LLM_INPUT_USD_PER_MTOK=
LLM_OUTPUT_USD_PER_MTOK=

# Rate limit per client IP on /auth/login and /auth/verify
AUTH_RATE_LIMIT_PER_MINUTE=10
