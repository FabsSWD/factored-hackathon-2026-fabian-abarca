# Public entry point (M19): the static app and, on the same origin, the API.
# ${PUBLIC_API_RATE_PER_SECOND} and ${PUBLIC_API_BURST} are filled in at start (envsubst).

# Public rate limit per client IP on every API route, before the API's own limits (per session
# on authenticated routes, per IP on /auth/login and /auth/verify).
limit_req_zone $binary_remote_addr zone=public_api:10m rate=${PUBLIC_API_RATE_PER_SECOND}r/s;
limit_req_status 429;
limit_req_log_level warn;

server_tokens off;

server {
    listen 80;
    root /usr/share/nginx/html;
    client_max_body_size 64k;

    # Docker's resolver, read on each request: a recreated api container keeps working.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api http://api:8000;

    # No location below sets add_header, so every response inherits these.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # The client IP replaces any X-Forwarded-For the client sent, so the API's per-IP limits
    # cannot be dodged with a forged header. Behind another proxy (TLS), set real_ip here.
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;

    location /api/ {
        limit_req zone=public_api burst=${PUBLIC_API_BURST} nodelay;
        proxy_pass $api;
    }

    location /auth/ {
        limit_req zone=public_api burst=${PUBLIC_API_BURST} nodelay;
        proxy_pass $api;
    }

    location = /health {
        proxy_pass $api;
    }

    # Hashed bundle files never change.
    location /assets/ {
        expires max;
        try_files $uri =404;
    }

    # Client-side routes (/agent, /agent/traces/...) are served by index.html.
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
